{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fieldos.invalid/schemas/content-pack.schema.json",
  "title": "FieldOS offline content pack manifest",
  "type": "object",
  "required": ["schema_version", "id", "version", "title", "description", "category", "sources", "artifacts", "geographic_coverage", "installation", "authority"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "geographic_scope": {"type": "string", "minLength": 1},
    "category": {"enum": ["agriculture", "wildlife-overlanding", "water-food", "first-aid-emergency", "weather-disaster", "communications", "maps-gis"]},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "name", "url", "license", "attribution"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "license": {"type": "string", "minLength": 1},
          "attribution": {"type": "string", "minLength": 1},
          "accessed": {"type": "string", "format": "date"}
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["path", "size_bytes", "sha256", "source", "license"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "source": {"type": "string", "minLength": 1},
          "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}},
          "license": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "index_with_ai": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "geographic_coverage": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "required": ["name", "bbox", "minzoom", "maxzoom"],
          "properties": {
            "name": {"type": "string"},
            "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
            "minzoom": {"type": "integer", "minimum": 0},
            "maxzoom": {"type": "integer", "minimum": 0},
            "crs": {"type": "string", "default": "EPSG:4326"}
          },
          "additionalProperties": false
        }
      ]
    },
    "installation": {
      "type": "object", "required": ["target", "requirements"],
      "properties": {
        "target": {"enum": ["storage/maps/pmtiles", "storage/references/documents", "storage/zim", "storage/content-packs"]},
        "requirements": {"type": "array", "items": {"type": "string"}},
        "optional": {"type": "boolean", "default": true}
      },
      "additionalProperties": false
    },
    "authority": {"enum": ["authoritative-reference", "community-reference", "fieldos-authored", "ai-generated", "mixed"]},
    "review": {
      "type": "object",
      "required": ["reviewer", "reviewed_at", "content_revision"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date"},
        "content_revision": {"type": "string", "format": "date"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
