[Unit]
Description=Complete Hckrslsh FieldOS local provisioning
After=docker.service
Wants=docker.service
ConditionPathExists=/opt/fieldos/payload/offline-payload.tar.zst

[Service]
Type=oneshot
ExecStart=/opt/fieldos/installer/provisioning/firstboot.sh
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
