[Unit]
Description=Complete Hckrslsh FieldOS local provisioning
After=docker.service
Before=display-manager.service graphical.target
Wants=docker.service

[Service]
Type=oneshot
ExecStart=/opt/fieldos/installer/provisioning/firstboot.sh
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
RequiredBy=display-manager.service graphical.target
