<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="org.fieldos.content-pack-import">
    <description>Install an offline FieldOS content pack</description>
    <message>Authenticate to verify and add this offline content pack.</message>
    <icon_name>fieldos</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/fieldos-content-pack-import-root</annotate>
  </action>
</policyconfig>
